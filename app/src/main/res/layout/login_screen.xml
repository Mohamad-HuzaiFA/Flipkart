<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".activities.MainActivity">

    <!-- Blue background with logo -->
    <RelativeLayout
        android:id="@+id/blueBackgrounddiv"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#0071DC"
        android:padding="16dp">

        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="wrap_content"
            android:layout_height="115dp"
            android:src="@drawable/flipkart_logo2"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:layout_marginStart="215dp"/>

        <!-- Flipkart Text -->
        <TextView
            android:id="@+id/LeftOfLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/logoImageView"
            android:layout_marginStart="-120dp"
            android:layout_marginTop="9dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/white"
            android:text="Flipkart"
            android:textSize="35sp"
            android:textStyle="italic" />

        <!-- Skip Arrow Icon and Text -->
        <ImageView
            android:id="@+id/skipIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/outline_arrow_right_alt_24"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:contentDescription="Skip" />

        <TextView
            android:id="@+id/skipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/skipIcon"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:text="Skip"
            android:textSize="14sp"
            android:textColor="@android:color/white" />

    </RelativeLayout>

    <!-- Initial description -->
    <TextView
        android:id="@+id/Initial_Description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/blueBackgrounddiv"
        android:layout_marginStart="30dp"
        android:layout_marginTop="15dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@android:color/black"
        android:text="@string/initDescription"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/Initial_Description_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/Initial_Description"
        android:layout_marginStart="30dp"
        android:layout_marginTop="7dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/initDescription_2"
        android:textSize="16sp" />

    <!-- Phone Number Input -->
    <EditText
        android:id="@+id/etPhoneNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/Initial_Description_2"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Phone Number"
        android:inputType="phone"
        android:padding="12dp" />

    <!-- Email Input -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etPhoneNumber"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:padding="12dp" />

    <!-- Terms Text -->
    <TextView
        android:id="@+id/tvTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/etEmail"
        android:layout_marginStart="40dp"
        android:layout_marginTop="25dp"
        android:layout_centerHorizontal="true"
        android:text="@string/terms_text"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:paddingHorizontal="16dp" />

    <!-- Login Button -->
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTerms"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="260dp"
        android:layout_marginBottom="16dp"
        android:text="LOGIN"
        android:textColor="@android:color/white"
        android:backgroundTint="#0071DC" />

    <!-- Sign Up Option -->
    <TextView
        android:id="@+id/tvSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="Don't have an account? Sign Up"
        android:textColor="#0071DC"
        android:textSize="16sp" />

</RelativeLayout>

