<resources>
    <style name="Base.Theme.Flipkart" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue</item>
        <item name="android:statusBarColor">@color/blue</item>
    </style>

    <!-- New theme without action bar -->
    <style name="Theme.Flipkart.NoActionBar" parent="Base.Theme.Flipkart">
        <item name="android:windowActionBar">false</item> <!-- Disable action bar -->
        <item name="android:windowNoTitle">true</item>   <!-- Remove title -->
    </style>

    <style name="Theme.Flipkart" parent="Base.Theme.Flipkart"/>

    <style name="App.Custom.Indicator" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:color">@color/yellow</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

